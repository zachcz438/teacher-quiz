---
import { TEACHER_TYPES, FAMILIES } from '@teacher-quiz/core';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>教师风格测评 · 发现你的教学 DNA</title>
  <meta name="description" content="30 道题，发现你的 16 型教学风格" />
</head>
<body>
  <main class="app">

    {/* ========== Welcome view ========== */}
    <section id="view-welcome" class="view active">
      <div class="welcome-hero">
        <span class="welcome-badge">教师风格测评 v2</span>
        <h1 class="welcome-title">发现你的<br/><em>教学风格</em></h1>
      </div>

      <div class="types-preview">
        {TEACHER_TYPES.map(t => (
          <div class="type-chip">
            <span class="em">{FAMILIES[t.family].emoji}</span>
            {t.name}
            <span class="fam">{FAMILIES[t.family].name}</span>
          </div>
        ))}
      </div>

      <div class="entry-cards">
        <button class="entry-card" data-version="basic">
          <span class="entry-emoji">⏱</span>
          <span class="entry-title">基础版</span>
          <span class="entry-meta">30 题 · 约 5 分钟</span>
          <span class="entry-desc">看见你的主类型 + 5 张标签 + 完整画像</span>
        </button>
        <button class="entry-card primary" data-version="pro">
          <span class="entry-emoji">🎯</span>
          <span class="entry-title">完整版</span>
          <span class="entry-meta">40 题 · 约 7 分钟</span>
          <span class="entry-desc">基础版全部内容 + 你的反思力深度解读</span>
        </button>
      </div>
      <div class="welcome-meta">
        <span>🎭 16 型 · 5 大家族</span>
        <span>🤝 性别中性 · 不下判决</span>
      </div>
    </section>

    {/* ========== Quiz view ========== */}
    <section id="view-quiz" class="view">
      <div class="quiz-header">
        <div class="quiz-meta">
          <span id="q-progress-text">第 1 题</span>
          <span><b id="q-current">1</b> / <span id="q-total">30</span></span>
        </div>
        <div class="progress"><div class="progress-fill" id="q-progress-fill" style="width: 3.3%"></div></div>
      </div>

      <div class="quiz-card card" id="q-card">
        {/* 由 JS 注入 */}
      </div>

      <div class="quiz-nav">
        <button class="btn btn-secondary" id="btn-prev">← 上一题</button>
        <button class="btn disabled" id="btn-next">下一题 →</button>
      </div>
    </section>

    {/* ========== Report view ========== */}
    <section id="view-report" class="view">
      <div class="report-hero card">
        <span class="tape pink left"></span>
        <span class="tape right"></span>
        <span class="report-badge" id="r-family">守护族 · 第 1/16 型</span>
        <span class="report-emoji" id="r-emoji">🌱</span>
        <h1 class="report-name" id="r-name">守望者</h1>
        <p class="report-tagline" id="r-tagline">默默守护学生成长</p>
      </div>

      <div class="card">
        <h3 class="section-title">你身上的 5 张标签</h3>
        <div class="tags-grid" id="r-tags"></div>
      </div>

      <div class="card">
        <span class="tape"></span>
        <h3 class="section-title">你这个人</h3>
        <p class="body-text" id="r-personality"></p>
      </div>

      <div class="card">
        <h3 class="section-title">你的教学超能力</h3>
        <div class="feature-list" id="r-superpowers"></div>
      </div>

      <div class="card">
        <h3 class="section-title">温柔的小提醒</h3>
        <div class="feature-list" id="r-weaknesses"></div>
      </div>

      <div class="card">
        <h3 class="section-title">风格亮点</h3>
        <p class="body-text" id="r-highlight"></p>
      </div>

      <div class="card">
        <h3 class="section-title">课堂场景画像</h3>
        <p class="body-text" id="r-classroom"></p>
      </div>

      <div class="card">
        <h3 class="section-title">你和学生的关系</h3>
        <p class="body-text" id="r-relation"></p>
      </div>

      <div class="card">
        <h3 class="section-title">高光时刻</h3>
        <p class="body-text" id="r-moment"></p>
      </div>

      <div class="card">
        <h3 class="section-title">容易踩的坑</h3>
        <p class="body-text" id="r-pitfall"></p>
      </div>

      <div class="card" id="r-reflection-card" style="display:none">
        <h3 class="section-title">你的反思力</h3>
        <p class="body-text" id="r-reflection"></p>
      </div>

      <div class="actions">
        <button class="btn btn-secondary" id="btn-restart">重新测试</button>
        <button class="btn" id="btn-share">复制结果</button>
      </div>
    </section>

  </main>

  <script>
    import {
      getQuestionPool,
      assembleTeacherReport,
    } from '@teacher-quiz/core';
    import type { Answer, Question } from '@teacher-quiz/core';

    /** 简易状态机 */
    type View = 'welcome' | 'quiz' | 'report';

    let version: 'basic' | 'pro' = 'basic';
    let questions: Question[] = getQuestionPool('basic');
    let answers: Map<number, string> = new Map();
    let currentIdx = 0;
    /** 每题的乱序映射：visualOrder[qid][i] = 视觉位置 i 上展示的原始 label */
    let visualOrder: Map<number, string[]> = new Map();
    const VISUAL_LABELS = ['A', 'B', 'C', 'D', 'E'];

    /** Fisher-Yates 洗牌 */
    function shuffle<T>(arr: T[]): T[] {
      const a = [...arr];
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j]!, a[i]!];
      }
      return a;
    }

    function buildVisualOrder() {
      visualOrder.clear();
      for (const q of questions) {
        const originalLabels = q.options.map(o => o.label);
        visualOrder.set(q.id, shuffle(originalLabels));
      }
    }

    function $<T extends HTMLElement = HTMLElement>(id: string): T {
      const el = document.getElementById(id);
      if (!el) throw new Error(`#${id} not found`);
      return el as T;
    }

    function showView(v: View) {
      document.querySelectorAll('.view').forEach(el => el.classList.remove('active'));
      $(`view-${v}`).classList.add('active');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function renderQuestion() {
      const q = questions[currentIdx];
      if (!q) return;

      $('q-current').textContent = String(currentIdx + 1);
      $('q-total').textContent = String(questions.length);
      $('q-progress-text').textContent = `第 ${currentIdx + 1} 题`;
      $('q-progress-fill').style.width = `${((currentIdx + 1) / questions.length) * 100}%`;

      const selected = answers.get(q.id);
      const order = visualOrder.get(q.id) ?? q.options.map(o => o.label);
      const optByLabel = new Map(q.options.map(o => [o.label, o]));

      const html = `
        <span class="quiz-cat">${q.category}</span>
        <h2 class="quiz-question">${q.text}</h2>
        <div class="options">
          ${order.map((origLabel, i) => {
            const o = optByLabel.get(origLabel)!;
            const visualLabel = VISUAL_LABELS[i] ?? origLabel;
            return `
              <button class="option ${selected === origLabel ? 'selected' : ''}" data-label="${origLabel}">
                <span class="label">${visualLabel}</span>
                <span>${o.text}</span>
              </button>
            `;
          }).join('')}
        </div>
      `;
      $('q-card').innerHTML = html;

      $('q-card').querySelectorAll('.option').forEach(el => {
        el.addEventListener('click', () => {
          const label = (el as HTMLElement).dataset.label;
          if (!label) return;
          answers.set(q.id, label);
          $('q-card').querySelectorAll('.option').forEach(o => o.classList.remove('selected'));
          el.classList.add('selected');
          $('btn-next').classList.remove('disabled');
        });
      });

      // Toggle nav button states
      ($('btn-prev') as HTMLButtonElement).disabled = currentIdx === 0;
      $('btn-prev').classList.toggle('disabled', currentIdx === 0);
      const isLast = currentIdx === questions.length - 1;
      $('btn-next').textContent = isLast ? '看结果 →' : '下一题 →';
      $('btn-next').classList.toggle('disabled', !answers.has(q.id));
    }

    function showReport() {
      // 拆分主测题答案 vs 成长题答案
      const mainAnswers: Answer[] = [];
      const growthAnswers: Answer[] = [];
      for (const [qid, label] of answers) {
        const q = questions.find(qq => qq.id === qid);
        if (!q) continue;
        const a = { questionId: qid, optionLabel: label };
        if (q.kind === 'growth') growthAnswers.push(a);
        else mainAnswers.push(a);
      }
      const report = assembleTeacherReport(mainAnswers, questions, version, growthAnswers);

      $('r-family').textContent = `${report.family.name} · 第 ${report.type.id}/16 型`;
      $('r-emoji').textContent = report.family.emoji;
      $('r-name').textContent = report.type.name;
      $('r-tagline').textContent = report.type.tagline;

      $('r-tags').innerHTML = report.binaryTags.map(t => `
        <span class="binary-tag"><span class="em">${t.emoji}</span>${t.label}</span>
      `).join('');

      $('r-personality').textContent = report.personality;
      $('r-highlight').textContent = report.highlight;
      $('r-classroom').textContent = report.classroomScene;
      $('r-relation').textContent = report.studentRelation;
      $('r-moment').textContent = report.idealMoment;
      $('r-pitfall').textContent = report.pitfall;

      $('r-superpowers').innerHTML = report.superpowers.map(s => `
        <div class="feature-item"><span class="ico">⚡</span><span>${s}</span></div>
      `).join('');
      $('r-weaknesses').innerHTML = report.weaknesses.map(w => `
        <div class="feature-item weak"><span class="ico">🌱</span><span>${w}</span></div>
      `).join('');

      // 反思力 section：仅当 pro 版且有 reflectionInsight
      const reflectionCard = $('r-reflection-card');
      if (report.reflectionInsight) {
        $('r-reflection').textContent = report.reflectionInsight;
        reflectionCard.style.display = '';
      } else {
        reflectionCard.style.display = 'none';
      }

      showView('report');
    }

    // === 事件绑定 ===
    document.querySelectorAll('.entry-card').forEach(card => {
      card.addEventListener('click', () => {
        const v = (card as HTMLElement).dataset.version;
        if (v !== 'basic' && v !== 'pro') return;
        version = v;
        questions = getQuestionPool(version);
        currentIdx = 0;
        answers.clear();
        buildVisualOrder();
        renderQuestion();
        showView('quiz');
      });
    });

    $('btn-prev').addEventListener('click', () => {
      if (currentIdx > 0) {
        currentIdx--;
        renderQuestion();
      }
    });

    $('btn-next').addEventListener('click', () => {
      const q = questions[currentIdx];
      if (!q || !answers.has(q.id)) return;
      if (currentIdx === questions.length - 1) {
        showReport();
      } else {
        currentIdx++;
        renderQuestion();
      }
    });

    $('btn-restart').addEventListener('click', () => {
      currentIdx = 0;
      answers.clear();
      visualOrder.clear();
      showView('welcome');
    });

    $('btn-share').addEventListener('click', async () => {
      const name = $('r-name').textContent;
      const family = $('r-family').textContent;
      const tagline = $('r-tagline').textContent;
      const text = `我是【${name}】— ${tagline}（${family}）· 教师风格测评`;
      try {
        await navigator.clipboard.writeText(text);
        ($('btn-share') as HTMLButtonElement).textContent = '已复制 ✓';
        setTimeout(() => ($('btn-share') as HTMLButtonElement).textContent = '复制结果', 2000);
      } catch {
        alert(text);
      }
    });
  </script>
</body>
</html>
